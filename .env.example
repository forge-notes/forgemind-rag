# Project
APP_STAGE=Day 6
APP_VERSION=0.1.0
TZ=Asia/Shanghai

# Ports exposed on the i5 Ubuntu server
FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_PORT=3306
QDRANT_PORT=6333

# MySQL 8
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=enterprise_knowledge_agent
MYSQL_USER=eka_user
MYSQL_PASSWORD=change_me_database_password
DATABASE_URL=mysql+pymysql://eka_user:change_me_database_password@mysql:3306/enterprise_knowledge_agent

# Qdrant
QDRANT_URL=http://qdrant:6333

# Embedding
# Ollama bge-m3 is used for real local embeddings.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_BASE=http://192.168.9.39:11434
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# LLM
# qwen generates the final RAG answer. bge-m3 is only for embedding.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_API_BASE=http://192.168.9.39:11434
LLM_API_KEY=

# Browser-facing frontend configuration
VITE_BACKEND_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# Project
APP_STAGE=Day 4
APP_VERSION=0.1.0
TZ=Asia/Shanghai

# Ports exposed on the i5 Ubuntu server
FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_PORT=3306
QDRANT_PORT=6333

# MySQL 8
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=enterprise_knowledge_agent
MYSQL_USER=eka_user
MYSQL_PASSWORD=change_me_database_password
DATABASE_URL=mysql+pymysql://eka_user:change_me_database_password@mysql:3306/enterprise_knowledge_agent

# Qdrant
QDRANT_URL=http://qdrant:6333

# Embedding
# local_hash is a deterministic Day 4 demo provider that needs no external API.
# Later it can be replaced with openai_compatible and real embedding credentials.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=local-hash-demo
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_DIM=384

# Browser-facing frontend configuration
VITE_BACKEND_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
